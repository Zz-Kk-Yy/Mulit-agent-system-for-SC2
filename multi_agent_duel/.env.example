# 复制本文件为 .env 或直接在 PowerShell 中设置同名环境变量（不要把含 Key 的文件提交到公开仓库）

# 必填：大模型 API Key（兼容 OpenAI 格式的网关均可）
# 可选覆盖：不写则使用 swarmbrain_llm_shared.py 与对局同源默认（千问 DashScope + 同源末位兜底 Key）。
SWARMBRAIN_LLM_API_KEY=

# Ask API 默认：阿里云 DashScope「OpenAI 兼容」+ 千问 3（与游戏本体 swarmbrain_launch 无强制绑定，可不填则使用下列默认）
# SWARMBRAIN_LLM_MODEL=qwen3-max
# SWARMBRAIN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# SWARMBRAIN_LLM_TEMPERATURE=0.35

# 若改用 OpenAI 官方，请显式设置（示例）：
# SWARMBRAIN_LLM_MODEL=gpt-4o-mini
# SWARMBRAIN_LLM_BASE_URL=https://api.openai.com/v1

# 无 Key 时自动允许关键词兜底；有 Key 时默认只用大模型。「大模型失败后仍要走关键词规则」时请设为 1：
# SWARMBRAIN_ASK_HEURISTIC=1

# 星际争霸 II 安装目录（与 swarmbrain_launch.py 中默认可二选一）
# SC2PATH=C:\Program Files (x86)\StarCraft II
# SWARMBRAIN_SC2PATH=C:\Program Files (x86)\StarCraft II

# 仪表盘内嵌游戏页 URL（可选）
# SWARMBRAIN_GAME_EMBED_URL=/game-view/

# 与 mass 同时开前端时请保持错开（默认已错开）：
# mass 仪表盘 8000 / Ask 8011
# duel 仪表盘 8100 / Ask 8111
# SWARMBRAIN_DUEL_DASHBOARD_PORT=8100
# SWARMBRAIN_DUEL_ASK_PORT=8111
